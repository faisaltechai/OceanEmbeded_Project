# --- Backend core ---
OCEANEMBED_ENV=development                 # development | demo | production
OCEANEMBED_BUNDLE_PATH=./data/demo/backend_bundle.json
OCEANEMBED_CORS_ORIGINS=http://localhost:5173
OCEANEMBED_ENABLE_SCHEDULER=true
OCEANEMBED_REPORTS_DIR=./data/reports

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000/api

# --- Database (Postgres + PostGIS app-state layer) ---
DATABASE_URL=postgresql+asyncpg://oceanembed:changeme@localhost:5432/oceanembed
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=oceanembed
POSTGRES_USER=oceanembed
POSTGRES_PASSWORD=changeme

# --- Cache ---
REDIS_URL=redis://localhost:6379/0         # omit/leave unset to use the in-memory fallback cache

# --- Auth ---
OCEANEMBED_JWT_SECRET=change-me-to-a-long-random-string
OCEANEMBED_JWT_EXPIRE_MINUTES=60

# --- Live satellite / ocean data credentials ---
# NOAA CoastWatch ERDDAP, Argovis (search), NOAA NHC cyclones: public, no key needed.

# Copernicus Marine Service - free account at https://data.marine.copernicus.eu
COPERNICUS_MARINE_USERNAME=
COPERNICUS_MARINE_PASSWORD=

# NASA EarthData / PO.DAAC - free account + token at
# https://urs.earthdata.nasa.gov/profile/apps
EARTHDATA_BEARER_TOKEN=

# Copernicus Climate Data Store (ERA5) - free account at
# https://cds.climate.copernicus.eu
CDS_API_KEY=
CDSAPI_URL=https://cds.climate.copernicus.eu/api

# Copernicus Data Space Ecosystem (Sentinel-3) - free account at
# https://dataspace.copernicus.eu
CDSE_USERNAME=
CDSE_PASSWORD=

# Argovis API key (optional - raises rate limits) - register at
# https://argovis-keygen.colorado.edu
ARGOVIS_API_KEY=
